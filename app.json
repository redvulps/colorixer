{
  "expo": {
    "name": "colorixer",
    "slug": "colorixer",
    "owner": "redvulps",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.redvulps.colorixer"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#111318"
      },
      "package": "com.redvulps.colorixer"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#111318"
        }
      ],
      "expo-font",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Colorixer opens the photos you pick to take their colors.",
          "cameraPermission": "Colorixer uses the camera to take a photo and pull its colors.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "d5a8b6ea-6802-4c3f-b08a-1c7341537f14"
      }
    },
    "backgroundColor": "#111318"
  }
}
